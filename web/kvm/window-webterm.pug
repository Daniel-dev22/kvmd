.hidden.window.window-elegant.window-resizable#webterm-window(data-wm-window-show-centered style="display: flex; min-width: min(720px, 100vw); min-height: min(480px, 100dvh)")
	.window-header
		.window-grab Terminal
		.window-buttons
			button(data-wm-window-set-original)
			button(data-wm-window-set-maximized)
			button(data-wm-window-close)
			// Без фуллскрина, так как терминал глючит из-за зажимаемой клавиши ESC для выхода

	//- No inline style: it would outrank every stylesheet rule, and the compact
	//- layout has to resize this iframe to zoom the terminal.
	iframe#webterm-iframe(src="")
