//- ===========================================================================
//- The on-screen keyboard.
//-
//- Every key is defined EXACTLY ONCE, in KB_KEYS below. The two arrangements
//- that follow -- the full desktop board and the layered compact board -- only
//- reference codes; neither of them restates a label.
//-
//- This file used to contain two hand-written boards. They had already drifted:
//- the mobile copy labelled Quote as a backtick, and the compact board was a
//- strict subset, so a phone could not send the numpad, Power, or any of the
//- Japanese keys at all -- 24 codes with no way to reach them.
//-
//- keypad.js binds by data-keypad-code and mirrors state across every element
//- carrying the same code, so a key present in both arrangements stays in sync.
//- ===========================================================================

-
	//- "mod":  a modifier. It does nothing pressed on its own, so a TAP latches
	//-         it -- a finger has no right button to hold it with.
	//- "hold": not a modifier, but may still be held or locked: PrintScreen for
	//-         SysRq, and the Japanese mode keys. A tap SENDS one of these; a
	//-         long press holds it. Both kinds render the latch bullet and both
	//-         take data-keypad-allow-autohold.
	var KB_KEYS = {
		"Escape": {"t": "Esc"},
		"F1": {"t": "F1"},
		"F2": {"t": "F2"},
		"F3": {"t": "F3"},
		"F4": {"t": "F4"},
		"F5": {"t": "F5"},
		"F6": {"t": "F6"},
		"F7": {"t": "F7"},
		"F8": {"t": "F8"},
		"F9": {"t": "F9"},
		"F10": {"t": "F10"},
		"F11": {"t": "F11"},
		"F12": {"t": "F12"},
		"Backquote": {"t": "~<br>`"},
		"Digit1": {"t": "!<br>1"},
		"Digit2": {"t": "@<br>2"},
		"Digit3": {"t": "#<br>3"},
		"Digit4": {"t": "$<br>4"},
		"Digit5": {"t": "%<br>5"},
		"Digit6": {"t": "^<br>6"},
		"Digit7": {"t": "&amp;<br>7"},
		"Digit8": {"t": "*<br>8"},
		"Digit9": {"t": "(<br>9"},
		"Digit0": {"t": ")<br>0"},
		"Minus": {"t": "_<br>-"},
		"Equal": {"t": "+<br>="},
		"Backspace": {"t": "&#8612;"},
		"Tab": {"t": "&#8676;<br>&#8677;"},
		"KeyQ": {"t": "Q"},
		"KeyW": {"t": "W"},
		"KeyE": {"t": "E"},
		"KeyR": {"t": "R"},
		"KeyT": {"t": "T"},
		"KeyY": {"t": "Y"},
		"KeyU": {"t": "U"},
		"KeyI": {"t": "I"},
		"KeyO": {"t": "O"},
		"KeyP": {"t": "P"},
		"BracketLeft": {"t": "{<br>["},
		"BracketRight": {"t": "}<br>]"},
		"Backslash": {"t": "|<br>&bsol;"},
		"CapsLock": {"t": "<br> Caps Lock", "lamp": "hid-keyboard-caps-led"},
		"KeyA": {"t": "A"},
		"KeyS": {"t": "S"},
		"KeyD": {"t": "D"},
		"KeyF": {"t": "F"},
		"KeyG": {"t": "G"},
		"KeyH": {"t": "H"},
		"KeyJ": {"t": "J"},
		"KeyK": {"t": "K"},
		"KeyL": {"t": "L"},
		"Semicolon": {"t": ":<br>;"},
		"Quote": {"t": "\"<br>'"},
		"Enter": {"t": "Enter<br>&crarr;"},
		"ShiftLeft": {"t": "Shift", "mod": true},
		"KeyZ": {"t": "Z"},
		"KeyX": {"t": "X"},
		"KeyC": {"t": "C"},
		"KeyV": {"t": "V"},
		"KeyB": {"t": "B"},
		"KeyN": {"t": "N"},
		"KeyM": {"t": "M"},
		"Comma": {"t": "&lt;<br>,"},
		"Period": {"t": "&gt;<br>."},
		"Slash": {"t": "?<br>/"},
		"ShiftRight": {"t": "Shift", "mod": true},
		"ControlLeft": {"t": "Ctrl", "mod": true},
		"MetaLeft": {"t": "Win", "mod": true},
		"AltLeft": {"t": "Alt", "mod": true},
		"Space": {"t": ""},
		"AltRight": {"t": "Alt", "mod": true},
		"MetaRight": {"t": "Win", "mod": true},
		"ContextMenu": {"t": "<br>Menu"},
		"ControlRight": {"t": "Ctrl", "mod": true},
		"PrintScreen": {"t": "Pt/Sq", "hold": true},
		"ScrollLock": {"t": "<br> ScrLk", "lamp": "hid-keyboard-scroll-led"},
		"Pause": {"t": "P/Brk"},
		"Insert": {"t": "Ins"},
		"Home": {"t": "Home"},
		"PageUp": {"t": "PgUp"},
		"Delete": {"t": "Del"},
		"End": {"t": "End"},
		"PageDown": {"t": "PgDn"},
		"ArrowUp": {"t": "&uarr;"},
		"ArrowLeft": {"t": "&larr;"},
		"ArrowDown": {"t": "&darr;"},
		"ArrowRight": {"t": "&rarr;"},
		"Power": {"t": "PWR"},
		"NumLock": {"t": "<br> NmLk", "lamp": "hid-keyboard-num-led"},
		"NumpadDivide": {"t": "/"},
		"NumpadMultiply": {"t": "*"},
		"NumpadSubtract": {"t": "-"},
		"Numpad7": {"t": "7<br>Home"},
		"Numpad8": {"t": "8<br>&uarr;"},
		"Numpad9": {"t": "9<br>PgUp"},
		"Numpad4": {"t": "4<br>&larr;"},
		"Numpad5": {"t": "5<br><br>"},
		"Numpad6": {"t": "6<br>&rarr;"},
		"NumpadAdd": {"t": "+"},
		"Numpad1": {"t": "1<br>End"},
		"Numpad2": {"t": "2<br>&darr;"},
		"Numpad3": {"t": "3<br>PgDn"},
		"Numpad0": {"t": "0<br>Ins"},
		"NumpadDecimal": {"t": ".<br>Del"},
		"NumpadEnter": {"t": "Ent"},
		"IntlBackslash": {"t": "&bsol;<br>|"},
		"IntlYen": {"t": "¥<br>_"},
		"IntlRo": {"t": "&bsol;<br>ろ"},
		"KanaMode": {"t": "Kana", "hold": true},
		"NonConvert": {"t": "N/Cnv", "hold": true},
		"Convert": {"t": "Cnv", "hold": true},
	};

	// Which compact layer each group of keys belongs to. Desktop shows
	// everything at once; compact shows one layer at a time.
	var KB_LAYERS = [
		{"id": "abc", "title": "ABC"},
		{"id": "sym", "title": "?123"},
		{"id": "fn", "title": "Fn"},
		{"id": "num", "title": "Num"},
		{"id": "intl", "title": "Intl"},
	];


//- The label is rendered in one place, so the two arrangements cannot disagree
//- about what a key says.
mixin kb_label(code)
	- var k = KB_KEYS[code]
	.label
		if k.lamp
			img(class=`inline-lamp-small ${k.lamp} led-gray` src=`${svg_dir}/led-square.svg`)
		if k.mod || k.hold
			b &bull;
			br
		!= k.t


mixin kb_spacer(sp)
	if sp == 1
		.spacer
	else if sp == 2
		.spacer-fixed


//- Desktop: unchanged geometry -- the same width classes and spacers as before.
mixin dk(code, sp, classes, width)
	- var k = KB_KEYS[code]
	div(
		data-keypad-code=code
		data-keypad-allow-autohold=(k.mod || k.hold ? true : false)
		data-keypad-modifier=(k.mod ? true : false)
		class=`key ${classes || ""}`
		style=(width ? `width: ${width}px` : "")
	)
		+kb_label(code)
	+kb_spacer(sp)


mixin dk_empty(sp, classes, width)
	div(class=`empty ${classes || ""}`, style=(width ? `width:${width}px` : ""))
		.label &nbsp;
	+kb_spacer(sp)


//- Compact: a 20-column grid per row, so a row can never be wider than the
//- viewport. `span` is in grid columns, not pixels.
mixin ck(code, span)
	- var k = KB_KEYS[code]
	div(
		data-keypad-code=code
		data-keypad-allow-autohold=(k.mod || k.hold ? true : false)
		data-keypad-modifier=(k.mod ? true : false)
		class="key"
		style=`--kc: ${span}`
	)
		+kb_label(code)


mixin ck_blank(span)
	div(class="empty" style=`--kc: ${span}`)


mixin ck_row(layer)
	div(class="keypad-row" data-keypad-layer=layer)
		block

.hidden.window#keyboard-window(data-wm-window-show-centered)
	.window-header#keyboard-window-header
		.window-grab Keyboard
		.window-buttons
			//- The mouse pad is not on screen unless it is asked for, so the
			//- way back to it lives here -- the mirror of the keyboard button
			//- the mouse pad's own header carries.
			button#keyboard-window-mouse-button(data-wm-window-show="mouse-window")
				img.led-gray(src=`${svg_dir}/led-hid-mouse.svg`)
			button(data-wm-window-set-original)
			button(data-wm-window-close)

	//- Layer picker. Only shown in the compact layout, where one layer is
	//- visible at a time; desktop shows every key at once and does not need it.
	.keypad-layers#keyboard-layers
		each layer in KB_LAYERS
			button(type="button" data-keypad-layer-button=layer.id)= layer.title

	//- ===================== desktop: every key, at once =====================
	.keypad#keyboard-desktop(align="center")
		.keypad-block
			.keypad-row
				+dk("Escape", 2, "small")
				+dk_empty(1, "", 24)
				each code in ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"]
					+dk(code, (code != "F12" ? 1 : 0), "small")
					if code == "F4" || code == "F8"
						+dk_empty(1, "", 10)
			hr
			.keypad-row
				+dk("Backquote", 1)
				each code in ["Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9", "Digit0"]
					+dk(code, 1)
				+dk("Minus", 1)
				+dk("Equal", 1)
				+dk("Backspace", 0, "wide-1 right")
			.keypad-row
				+dk("Tab", 1, "wide-1 left")
				each letter in ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]
					+dk(`Key${letter}`, 1, "single")
				+dk("BracketLeft", 1)
				+dk("BracketRight", 1)
				+dk("Backslash", 0)
			.keypad-row
				+dk("CapsLock", 1, "wide-2 left small")
				each letter in ["A", "S", "D", "F", "G", "H", "J", "K", "L"]
					+dk(`Key${letter}`, 1, "single")
				+dk("Semicolon", 1)
				+dk("Quote", 1)
				+dk("Enter", 0, "wide-2 right small")
			.keypad-row
				+dk("ShiftLeft", 1, "wide-3 left small")
				each letter in ["Z", "X", "C", "V", "B", "N", "M"]
					+dk(`Key${letter}`, 1, "single")
				+dk("Comma", 1)
				+dk("Period", 1)
				+dk("Slash", 1)
				+dk("ShiftRight", 0, "wide-3 right small")
			.keypad-row
				+dk("ControlLeft", 2, "wide-1 left small")
				+dk("MetaLeft", 2, "wide-1 left small")
				+dk("AltLeft", 2, "wide-1 left small")
				+dk("Space", 2, "wide-4")
				+dk("AltRight", 2, "wide-1 right small")
				+dk("MetaRight", 2, "wide-1 right small")
				+dk("ContextMenu", 2, "small")
				+dk("ControlRight", 0, "wide-1 right small")
		.keypad-block
			.keypad-row
				+dk("PrintScreen", 2, "small")
				+dk("ScrollLock", 2, "small")
				+dk("Pause", 0, "small")
			hr
			.keypad-row
				+dk("Insert", 2, "small")
				+dk("Home", 2, "small")
				+dk("PageUp", 0, "small")
			.keypad-row
				+dk("Delete", 2, "small")
				+dk("End", 2, "small")
				+dk("PageDown", 0, "small")
			.keypad-row
			.keypad-row
				+dk_empty(1, "")
				+dk("ArrowUp", 2)
				+dk_empty(0, "")
			.keypad-row
				+dk("ArrowLeft", 2)
				+dk("ArrowDown", 2)
				+dk("ArrowRight", 0)
		.keypad-block
			.keypad-row
				+dk_empty(2, "small")
				+dk_empty(2, "small")
				+dk_empty(2, "small")
				+dk("Power", 0, "small")
			hr
			.keypad-row
				+dk("NumLock", 2, "small")
				+dk("NumpadDivide", 2)
				+dk("NumpadMultiply", 2)
				+dk("NumpadSubtract", 0)
			.keypad-row
				+dk("Numpad7", 2, "small")
				+dk("Numpad8", 2, "small")
				+dk("Numpad9", 2, "small")
				+dk_empty(0, "")
			.keypad-row
				+dk("Numpad4", 2, "small")
				+dk("Numpad5", 2, "small")
				+dk("Numpad6", 2, "small")
				+dk("NumpadAdd", 0)
			.keypad-row
				+dk("Numpad1", 2, "small")
				+dk("Numpad2", 2, "small")
				+dk("Numpad3", 2, "small")
				+dk_empty(0, "")
			.keypad-row
				+dk("Numpad0", 2, "small")
				+dk_empty(2, "")
				+dk("NumpadDecimal", 2, "small")
				+dk("NumpadEnter", 0, "small")
		.keypad-block
			.keypad-row
				+dk("IntlBackslash", 0, "small")
			hr
			.keypad-row
				+dk("IntlYen", 0, "small")
			.keypad-row
				+dk("IntlRo", 0, "small")
			.keypad-row
				+dk("KanaMode", 0, "small")
			.keypad-row
				+dk("NonConvert", 0, "small")
			.keypad-row
				+dk("Convert", 0, "small")

	//- ========= compact: the phone's own keyboard first =========
	//- Typing goes through the host's keymap on the server (api/hid/print), so
	//- swipe, dictation, long-press accents and autocorrect all work at real
	//- speed. What an IME cannot produce -- Esc, the modifiers, Tab, arrows --
	//- sits in a strip that is always on screen, and the full scancode board is
	//- one tap away for a BIOS or a boot menu.
	.keypad#keyboard-compact(data-layer="abc")
		+ck_row("abc")
			each letter in ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]
				+ck(`Key${letter}`, 2)
		+ck_row("abc")
			+ck_blank(1)
			each letter in ["A", "S", "D", "F", "G", "H", "J", "K", "L"]
				+ck(`Key${letter}`, 2)
			+ck_blank(1)
		+ck_row("abc")
			each letter in ["Z", "X", "C", "V", "B", "N", "M"]
				+ck(`Key${letter}`, 2)
			+ck("Backspace", 6)
		+ck_row("abc")
			+ck("Space", 10)
			+ck("Comma", 3)
			+ck("Period", 3)
			+ck("Enter", 4)

		+ck_row("sym")
			each code in ["Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9", "Digit0"]
				+ck(code, 2)
		+ck_row("sym")
			+ck_blank(1)
			each code in ["Backquote", "Minus", "Equal", "BracketLeft", "BracketRight", "Backslash", "Semicolon", "Quote", "Slash"]
				+ck(code, 2)
			+ck_blank(1)
		+ck_row("sym")
			+ck("CapsLock", 4)
			+ck("ContextMenu", 4)
			+ck("ShiftRight", 4)
			+ck("MetaRight", 4)
			+ck("AltRight", 4)

		+ck_row("fn")
			each code in ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"]
				+ck(code, 2)
		+ck_row("fn")
			+ck("F11", 2)
			+ck("F12", 2)
			+ck("PrintScreen", 4)
			+ck("ScrollLock", 4)
			+ck("Pause", 4)
			+ck("Power", 4)
		+ck_row("fn")
			each code in ["Insert", "Home", "PageUp", "Delete", "End", "PageDown"]
				+ck(code, 3)
			+ck_blank(2)

		+ck_row("num")
			+ck("NumLock", 5)
			+ck("NumpadDivide", 5)
			+ck("NumpadMultiply", 5)
			+ck("NumpadSubtract", 5)
		+ck_row("num")
			+ck("Numpad7", 5)
			+ck("Numpad8", 5)
			+ck("Numpad9", 5)
			+ck("NumpadAdd", 5)
		+ck_row("num")
			+ck("Numpad4", 5)
			+ck("Numpad5", 5)
			+ck("Numpad6", 5)
			+ck_blank(5)
		+ck_row("num")
			+ck("Numpad1", 5)
			+ck("Numpad2", 5)
			+ck("Numpad3", 5)
			+ck("NumpadEnter", 5)
		+ck_row("num")
			+ck("Numpad0", 10)
			+ck("NumpadDecimal", 5)
			+ck_blank(5)

		+ck_row("intl")
			each code in ["IntlBackslash", "IntlYen", "IntlRo", "KanaMode", "NonConvert"]
				+ck(code, 4)
		+ck_row("intl")
			+ck("Convert", 4)
			+ck("ControlRight", 4)
			+ck_blank(12)

		//- Always on screen, whichever layer is showing and whether or not the
		//- native keyboard is up. A phone IME cannot send any of these.
		div(class="keypad-row keypad-strip" data-keypad-persistent)
			+ck("Escape", 3)
			+ck("Tab", 3)
			+ck("ControlLeft", 3)
			+ck("AltLeft", 3)
			+ck("MetaLeft", 4)
			+ck("ShiftLeft", 4)
		div(class="keypad-row keypad-strip" data-keypad-persistent)
			+ck("ArrowLeft", 5)
			+ck("ArrowDown", 5)
			+ck("ArrowUp", 5)
			+ck("ArrowRight", 5)

		//- Sits at the bottom so it is directly above the system keyboard when
		//- that opens. 16px or larger, or iOS zooms the page on focus.
		.keypad-type
			input#hid-type-input(
				type="text"
				inputmode="text"
				enterkeyhint="enter"
				autocomplete="off"
				autocorrect="off"
				autocapitalize="off"
				spellcheck="false"
				placeholder="Tap to type on the host"
				aria-label="Type on the host"
			)
			button#hid-type-clear(type="button" title="Clear") &times;
