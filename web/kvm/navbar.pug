mixin navbar_led(id, icon, cls="led-gray")
	img(id=id, class=cls src=`${svg_dir}/${icon}.svg`)


mixin menu_message(icon, short, classes="")
	.text
		table
			tr
				td(rowspan="2") #[img(class=`sign ${classes}` src=`${svg_dir}/${icon}.svg`)]
				td(style="line-height:1.5") #[b #{short}]
			if block
				tr
					td
						sup(style="line-height:1")
							block


mixin menu_switch_gpio(channel, confirm_off="")
	.switch-box
		input(
			disabled
			type="checkbox"
			id=`__gpio-switch-${channel}`
			class=`__gpio-switch-${channel} gpio-switch`
			data-gpio-channel=channel
			data-gpio-confirm-off=confirm_off
		)
		label(for=`__gpio-switch-${channel}`)
			span.switch-inner
			span.switch


mixin menu_switch(id, enabled, checked)
	.switch-box
		input(checked=checked disabled=!enabled type="checkbox" id=id)
		label(for=id)
			span.switch-inner
			span.switch


mixin menu_switch_table(id, enabled, checked)
	table.kv
		tr
			td
				block
			td #[+menu_switch(id, enabled, checked)]


mixin menu_radio_items(name, items)
	each item in items
		-
			let id = `${name}-${item["value"]}`
			let checked = (item["checked"] || false)
		input(type="radio" id=id name=name value=item["value"] checked=checked)
		label(for=id) !{item["title"]}


mixin menu_radio(name, items)
	.radio-box
		+menu_radio_items(name, items)


mixin menu_slider(slider_id, value_id, enabled=true)
	table
		td.slider-inner
			input(type="range" id=slider_id disabled=!enabled)
		td.slider-value(id=value_id)


mixin menu_spoiler(title)
	details
		summary !{title}
		div(class="spoiler")
			block


button.hidden#navbar-show-button(data-wm-navbar-show data-wm-on-full-tab)

ul#navbar
	li.left
		a.menu-item.menu-action(href=root_prefix)
			div &larr;
			img.svg-gray(src=`${svg_dir}/logo.svg` alt="&pi;-kvm")

	//- Link, video, keyboard and mouse. These lived inside the System button,
	//- which made it the widest thing on the bar -- and in the compact layout
	//- they scrolled off with it. Status you cannot see is not status.
	li.left#navbar-status
		.menu-item
			+navbar_led("link-led", "led-link")
			+navbar_led("stream-led", "led-video")
			+navbar_led("hid-keyboard-led", "led-hid-keyboard")
			+navbar_led("hid-mouse-led", "led-hid-mouse")

	include navbar-health.pug

	.hidden#navbar-stream-info(data-wm-on-full-tab)
		li.left
			.menu-item
				#stream-info

	.hidden(data-wm-on-full-tab)
		li.right
			.menu-item
				button(data-wm-navbar-close style="width: 50px; height: 30px;")
				button(data-wm-normalize style="width: 30px; height: 30px;")

	//- Compact only: one button, and the sections behind it. The strip was
	//- 815px wide on a 390px screen with a Switch attached -- 52% of it past
	//- the right edge, with ATX onwards never seen. Desktop renders the
	//- sections exactly as before; #navbar-sections is display: contents there.
	li.right.navbar-compact-only#navbar-menu
		.menu-item.menu-action#navbar-menu-button(role="button" tabindex="0")
			div &#9776;
			span Menu

	#navbar-sections
		//- The two things a phone opens constantly, at the top level instead of
		//- the last row of the System sheet. Compact only: on desktop these
		//- windows are opened from System, and the sections container is
		//- display: contents, so without the class they would appear in the
		//- desktop navbar too.
		li.right.navbar-compact-only#keyboard-section
			.menu-item.menu-action(data-wm-window-show="keyboard-window" role="button" tabindex="0")
				img.svg-gray(src=`${svg_dir}/led-hid-keyboard.svg` alt="")
				span Keyboard
		li.right.navbar-compact-only#mouse-section
			.menu-item.menu-action(data-wm-window-show="mouse-window" role="button" tabindex="0")
				img.svg-gray(src=`${svg_dir}/led-hid-mouse.svg` alt="")
				span Mouse

		include navbar-system.pug
		include navbar-atx.pug
		include navbar-msd.pug
		include navbar-macro.pug
		include navbar-text.pug
		include navbar-shortcuts.pug
		include navbar-gpio.pug
		include navbar-switch.pug
