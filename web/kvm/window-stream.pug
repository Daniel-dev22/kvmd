.hidden.window#stream-ocr-window
	.hidden#stream-ocr-selection

	//- Enter and Escape are the whole interface to this overlay, and a phone
	//- has neither. Same two actions, reachable by a finger.
	#stream-ocr-controls
		button#stream-ocr-confirm-button(disabled) &bull; Recognize
		button#stream-ocr-cancel-button &bull; Cancel

.hidden.window.window-elegant.window-resizable#stream-window(data-wm-window-show-maximized data-wm-organize-hook)
	.window-header#stream-window-header
		.window-grab MJPEG
		.window-buttons
			//- Compact only. Zoomed to 250% you see a quarter of the console,
			//- and getting back to a part you cannot see means zooming out,
			//- dragging, and zooming in again -- having lost where you were.
			//- This shows the whole screen on one tap and RESTORES the exact
			//- view on the next, so looking somewhere else costs nothing.
			button#stream-fit-button(type="button" title="Fit the whole console, and back")
			button(data-wm-window-set-full-screen)
			button(data-wm-window-set-full-tab)
			button(data-wm-window-set-original)
			button(data-wm-window-set-maximized)
			button(data-wm-window-close)

	.stream-box-offline#stream-box
		#stream-keyboard-magic
		img#stream-image(src=`${pic_dir}/blank-stream.webp`)
		video.hidden#stream-video(disablePictureInPicture="true" autoplay playsinline muted)
		canvas.hidden#stream-canvas
		#stream-fullscreen-active
